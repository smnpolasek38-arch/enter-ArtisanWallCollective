{%- comment -%} Trust badges {%- endcomment -%}
<div class="section--bordered" style="padding-block:3.5rem;background:color-mix(in srgb, var(--color-secondary) 50%, transparent)">
  <div class="page-width trust-grid">
    {%- for block in section.blocks -%}
      <div class="trust-badge" data-reveal data-reveal-delay="{{ forloop.index0 | times: 60 }}">
        <span class="trust-badge__icon">{% render 'icon', icon: block.settings.icon %}</span>
        <div>
          <p class="trust-badge__title">{{ block.settings.title }}</p>
          <p class="trust-badge__text">{{ block.settings.text }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust badges",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "frame", "label": "Frame" },
            { "value": "rotate", "label": "Returns" },
            { "value": "shield", "label": "Shield" },
            { "value": "clock", "label": "Clock" },
            { "value": "check", "label": "Check" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "title": "Free shipping", "text": "On orders over $75" } },
        { "type": "badge", "settings": { "icon": "frame", "title": "Framed by hand", "text": "Shipped ready to hang" } },
        { "type": "badge", "settings": { "icon": "rotate", "title": "30-day returns", "text": "Love it or send it back" } },
        { "type": "badge", "settings": { "icon": "shield", "title": "Secure checkout", "text": "Shop with confidence" } }
      ]
    }
  ]
}
{% endschema %}
