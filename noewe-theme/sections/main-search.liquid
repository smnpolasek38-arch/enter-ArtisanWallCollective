{%- comment -%} Main search section {%- endcomment -%}
<section class="page-width page-content">
  <h1 class="display-s">{{ 'search.title' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
      aria-label="{{ 'search.placeholder' | t }}"
    >
    <button type="submit" class="btn btn--primary btn--xl">{% render 'icon', icon: 'search' %}</button>
  </form>

  {%- paginate search.results by section.settings.results_per_page -%}
    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p style="margin-top:2.5rem;color:var(--color-muted-foreground)">
          {{ 'search.no_results' | t: terms: search.terms }}
        </p>
      {%- else -%}
        <p class="kicker" style="margin-top:2.5rem">
          {{ 'search.results' | t: count: search.results_count }}
        </p>
        <div class="search-results">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="article-card">
                {%- if item.image -%}
                  {%- assign item_alt = item.image.alt | escape -%}
                  {{ item.image | image_url: width: 600 | image_tag: class: 'article-card__img', loading: 'lazy', alt: item_alt }}
                {%- endif -%}
                <h3 class="article-card__title">{{ item.title }}</h3>
                <p class="article-card__excerpt">{{ item.content | strip_html | truncate: 120 }}</p>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" role="navigation" aria-label="Pagination">
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a class="pagination__item" href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span class="pagination__item{% if part.title == paginate.current_page %} is-active{% endif %}" {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    }
  ]
}
{% endschema %}
