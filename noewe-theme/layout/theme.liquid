<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">

    {%- if settings.favicon -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- render 'social-meta-tags' -%}

    <link rel="canonical" href="{{ canonical_url }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=DM+Mono:wght@300;400;500&display=swap"
      rel="stylesheet"
    >

    {%- comment -%} Core design tokens, overridable in Theme settings {%- endcomment -%}
    <style>
      :root {
        --color-background: {{ settings.color_background | default: '#F9F7F2' }};
        --color-foreground: {{ settings.color_foreground | default: '#1A1714' }};
        --color-card: {{ settings.color_card | default: '#FBF9F5' }};
        --color-secondary: {{ settings.color_secondary | default: '#EFE9DD' }};
        --color-muted: {{ settings.color_muted | default: '#F1ECE1' }};
        --color-muted-foreground: {{ settings.color_muted_foreground | default: '#6B645C' }};
        --color-accent: {{ settings.color_accent | default: '#85502D' }};
        --color-destructive: {{ settings.color_destructive | default: '#BB2E23' }};
        --color-border: {{ settings.color_border | default: '#E2DACB' }};
        --page-width: {{ settings.page_width | default: 1440 }}px;
        --section-padding: {{ settings.section_padding | default: 7 }}rem;
        --radius: {{ settings.radius | default: 2 }}px;
        --shadow-card: 0 1px 2px rgba(26, 23, 20, 0.04), 0 12px 32px -12px rgba(26, 23, 20, 0.12);
        --shadow-hover: 0 2px 4px rgba(26, 23, 20, 0.04), 0 24px 48px -24px rgba(26, 23, 20, 0.18);
        --gradient-overlay: linear-gradient(to top, rgba(26, 23, 20, 0.6) 0%, rgba(26, 23, 20, 0) 60%);
      }
    </style>

    {{ 'noewe.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>

    {{ content_for_header }}
  </head>

  <body
    class="template-{{ request.page_type | handle }}"
    data-free-shipping="{{ settings.free_shipping_threshold | default: 75 }}"
    data-cart-note="{{ settings.cart_note | default: '30-day guarantee · Secure payment · Ships in 24h' | escape }}"
    data-cart-empty-text="{{ 'cart.empty' | t | escape }}"
    data-collections-url="{{ routes.all_products_collection_url }}"
    data-cart-browse-text="{{ 'cart.empty_text' | t | escape }}"
    data-cart-progress-text="{{ 'layout.cart.free_shipping_progress' | t: amount: '__AMOUNT__' }}"
    data-cart-progress-reached="{{ 'layout.cart.free_shipping_reached' | t }}"
    data-add-to-cart-text="{{ 'products.product.add_to_cart' | t }}"
    data-sold-out-text="{{ 'products.product.sold_out' | t }}"
    data-unavailable-text="{{ 'products.product.unavailable' | t }}"
  >
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% sections 'overlay-group' %}

    <div class="cart-drawer-backdrop" data-cart-backdrop></div>

    <script src="{{ 'noewe.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
